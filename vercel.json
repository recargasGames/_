{
    "version": 2,
    "builds": [
        {
            "src": "api/**/*.js",
            "use": "@vercel/node"
        },
        {
            "src": "**/*.html",
            "use": "@vercel/static"
        }
    ],
    "routes": [
        {
            "src": "/api/(.*)",
            "dest": "/api/$1"
        },
        {
            "src": "/pasarela.html",
            "dest": "/pasarela.html"
        },
        {
            "src": "/(.*)",
            "dest": "/index.html"
        }
    ]
}
