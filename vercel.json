{
    "version": 2,
    "builds": [
        {
            "src": "api/**/*.js",
            "use": "@vercel/node"
        },
        {
            "src": "**/*.html",
            "use": "@vercel/static"
        },
        {
            "src": "**/*.png",
            "use": "@vercel/static"
        },
        {
            "src": "**/*.jpg",
            "use": "@vercel/static"
        },
        {
            "src": "**/*.jpeg",
            "use": "@vercel/static"
        },
        {
            "src": "**/*.gif",
            "use": "@vercel/static"
        },
        {
            "src": "**/*.svg",
            "use": "@vercel/static"
        },
        {
            "src": "**/*.ico",
            "use": "@vercel/static"
        },
        {
            "src": "**/*.css",
            "use": "@vercel/static"
        },
        {
            "src": "**/*.js",
            "use": "@vercel/static"
        }
    ],
    "routes": [
        {
            "src": "/api/(.*)",
            "dest": "/api/$1"
        },
        {
            "src": "/pasarela.html",
            "dest": "/pasarela.html"
        },
        {
            "src": "/freefire.html",
            "dest": "/freefire.html"
        },
        {
            "src": "/bloodstrike.html",
            "dest": "/bloodstrike.html"
        },
        {
            "src": "/roblox.html",
            "dest": "/roblox.html"
        },
        {
            "src": "/ml.html",
            "dest": "/ml.html"
        },
        {
            "src": "/dashboard.html",
            "dest": "/dashboard.html"
        },
        {
            "src": "/register.html",
            "dest": "/register.html"
        },
        {
            "src": "/arenabreakout.html",
            "dest": "/arenabreakout.html"
        },
        {
            "src": "/delta.html",
            "dest": "/delta.html"
        },
        {
            "src": "/netflix.html",
            "dest": "/netflix.html"
        },
        {
            "src": "/disney.html",
            "dest": "/disney.html"
        },
        {
            "src": "/cod.html",
            "dest": "/cod.html"
        },
        {
            "src": "/pubg.html",
            "dest": "/pubg.html"
        },
        {
            "src": "/nent.html",
            "dest": "/nent.html"
        },
        {
            "src": "/(.*)\\.(png|jpg|jpeg|gif|svg|ico|css|js)",
            "dest": "/$1.$2"
        },
        {
            "src": "/",
            "dest": "/index.html"
        },
        {
            "src": "/(.*)",
            "dest": "/index.html"
        }
    ]
}
