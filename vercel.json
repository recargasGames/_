{
    "version": 2,
    "builds": [
        {
            "src": "api/**/*.js",
            "use": "@vercel/node"
        },
        {
            "src": "**/*.html",
            "use": "@vercel/static"
        },
        {
            "src": "**/*.png",
            "use": "@vercel/static"
        },
        {
            "src": "**/*.jpg",
            "use": "@vercel/static"
        },
        {
            "src": "**/*.jpeg",
            "use": "@vercel/static"
        }
    ],
    "routes": [
        {
            "src": "/api/(.*)",
            "dest": "/api/$1"
        },
        {
            "src": "/pasarela.html",
            "dest": "/pasarela.html"
        },
        {
            "src": "/(.*)\\.(png|jpg|jpeg)",
            "dest": "/$1.$2"
        },
        {
            "src": "/(.*)",
            "dest": "/index.html"
        }
    ]
}
