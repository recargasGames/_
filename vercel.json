{
  "version": 2,
  "functions": {
    "api/*.js": {
      "runtime": "@vercel/node@3"
    }
  },
  "rewrites": [
    { "source": "/api/pabilo", "destination": "/api/pabilo.js" },
    { "source": "/api/recarga", "destination": "/api/recarga.js" },
    { "source": "/api/telegram", "destination": "/api/telegram.js" }
  ]
}
