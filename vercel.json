{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/pabilo",
      "dest": "api/pabilo.js",
      "methods": ["POST", "OPTIONS"]
    },
    {
      "src": "/api/recarga",
      "dest": "api/recarga.js",
      "methods": ["POST", "OPTIONS"]
    },
    {
      "src": "/api/telegram",
      "dest": "api/telegram.js",
      "methods": ["POST", "OPTIONS"]
    }
  ]
}

