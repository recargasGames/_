{
    "version": 2,
    "builds": [
        {
            "src": "api/**/*.js",
            "use": "@vercel/node"
        },
        {
            "src": "**/*.html",
            "use": "@vercel/static"
        },
        {
            "src": "**/*.png",
            "use": "@vercel/static"
        },
        {
            "src": "**/*.jpg",
            "use": "@vercel/static"
        }
    ],
    "routes": [
        {
            "src": "/api/(.*)",
            "dest": "/api/$1"
        },
        {
            "src": "/(.*)\\.html",
            "dest": "/$1.html"
        },
        {
            "src": "/freefire",
            "dest": "/freefire.html"
        },
        {
            "src": "/roblox",
            "dest": "/roblox.html"
        },
        {
            "src": "/bloodstrike",
            "dest": "/bloodstrike.html"
        },
        {
            "src": "/ml",
            "dest": "/ml.html"
        },
        {
            "src": "/cod",
            "dest": "/cod.html"
        },
        {
            "src": "/pubg",
            "dest": "/pubg.html"
        },
        {
            "src": "/arenabreakout",
            "dest": "/arenabreakout.html"
        },
        {
            "src": "/delta",
            "dest": "/delta.html"
        },
        {
            "src": "/netflix",
            "dest": "/netflix.html"
        },
        {
            "src": "/disney",
            "dest": "/disney.html"
        },
        {
            "src": "/dashboard",
            "dest": "/dashboard.html"
        },
        {
            "src": "/perfil",
            "dest": "/perfil.html"
        },
        {
            "src": "/pedidos",
            "dest": "/pedidos.html"
        },
        {
            "src": "/pasarela",
            "dest": "/pasarela.html"
        },
        {
            "src": "/",
            "dest": "/index.html"
        },
        {
            "src": "/(.*)",
            "dest": "/index.html"
        }
    ]
}
