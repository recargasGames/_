{
  "version": 2,
   "builds": [
     {
       "src": "api/*.js",
       "use": "@vercel/node"
     }
   ],
   "routes": [
     {
       "src": "/api/pabilo",
       "dest": "api/pabilo.js"
     },
     {
       "src": "/api/recarga",
       "dest": "api/recarga.js"
     },
     {
       "src": "/api/telegram",
       "dest": "api/telegram.js"
     }
   ]
 }
