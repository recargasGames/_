{
    "version": 2,
    "builds": [
        {
            "src": "api/**/*.js",
            "use": "@vercel/node"
        },
        {
            "src": "public/**",
            "use": "@vercel/static"
        }
    ],
    "routes": [
        {
            "src": "/api/(.*)",
            "dest": "/api/$1"
        },
        {
            "src": "/pasarela.html",
            "dest": "/public/pasarela.html"
        },
        {
            "src": "/freefire.html",
            "dest": "/public/freefire.html"
        },
        {
            "src": "/roblox.html",
            "dest": "/public/roblox.html"
        },
        {
            "src": "/bloodstrike.html",
            "dest": "/public/bloodstrike.html"
        },
        {
            "src": "/mobilelegends.html",
            "dest": "/public/mobilelegends.html"
        },
        {
            "src": "/arenabreakout.html",
            "dest": "/public/arenabreakout.html"
        },
        {
            "src": "/(.*)",
            "dest": "/public/$1"
        }
    ]
}
